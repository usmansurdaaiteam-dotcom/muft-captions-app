{
  "id": "muft-glow",
  "name": "Muft Glow",
  "description": "Muft-style amber emphasis with soft centered glow, Inter font, drop shadow.",

  "hero": {
    "fontFamily": "Inter",
    "fontWeight": 900,
    "fontSize": 140,
    "color": "#A0D83E",
    "uppercase": true,
    "letterSpacing": 0,

    "glow": {
      "enabled": true,
      "passes": [
        { "blur": 50, "opacity": 0.25, "offset": [0, 0] },
        { "blur": 20, "opacity": 0.5,  "offset": [0, 0] }
      ]
    },

    "dropShadow": {
      "enabled": true,
      "color": "#000000",
      "opacity": 0.35,
      "offset": [5, 5],
      "blur": 15
    },

    "stroke": {
      "enabled": false,
      "color": "#000000",
      "width": 0
    }
  },

  "support": {
    "fontFamily": "Inter",
    "fontWeight": 800,
    "fontSize": 52,
    "color": "#FFFFFF",
    "uppercase": false,
    "letterSpacing": 0,
    "lineSpacing": 0.9,

    "glow": {
      "enabled": false,
      "passes": []
    },

    "dropShadow": {
      "enabled": true,
      "color": "#000000",
      "opacity": 0.35,
      "offset": [5, 5],
      "blur": 15
    },

    "stroke": {
      "enabled": false,
      "color": "#000000",
      "width": 0
    }
  },

  "layout": {
    "type": "staggered",
    "description": "Before text left-aligned above hero, hero centered, after text right-aligned below hero.",
    "canvasWidth": 1080,
    "canvasHeight": 1920,
    "captionCenterY": 0.55,
    "positions": {
      "emphasis": {
        "before": { "anchor": "left",   "yOffset": -100 },
        "hero":   { "anchor": "center", "yOffset": 0 },
        "after":  { "anchor": "right",  "yOffset": 100 }
      },
      "plain": {
        "text": { "anchor": "center", "yOffset": 0 }
      },
      "spotlight": {
        "hero": { "anchor": "center", "yOffset": 0 }
      }
    }
  },

  "emphasis": {
    "mode": "randomized",
    "emphasisRate": 0.65,
    "spotlightRate": 0.08,
    "maxConsecutiveEmphasis": 2,
    "description": "Not every line gets emphasis. ~65% get emphasis, ~8% spotlight, rest plain white."
  },

  "fonts": {
    "hero": "Inter-Black.otf",
    "support": "Inter-ExtraBold.ttf"
  }
}
