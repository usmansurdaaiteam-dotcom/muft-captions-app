# Copy to .env and adjust. Everything here has a working default, so the app
# runs without any of it set.

# HTTP port.
PORT=3000

# Shared password for the team.
ACCESS_PASSWORD=muftcaptions2026

# Set to false to drop the password gate entirely. Only do this when the app is
# not reachable from the internet.
REQUIRE_PASSWORD=true

# Speech-to-text.
SONIOX_API_KEY=


# ─── Caption composition (grouping, emphasis, script conversion) ──────────────
#
# Without one of the two options below, the app falls back to a hand-rolled
# client that talks to gemini.google.com with hardcoded Google session cookies.
# Those cookies expire on their own after a few weeks, and when they do the
# pipeline does not error — it quietly starts guessing the emphasis word (longest
# word in the line) and stops converting Urdu to Roman Urdu.
#
# Run `npm run gemini:doctor` at any time to see what is actually configured.

# Option 1 — AIStudioToAPI (or any Gemini-compatible proxy).
#
# https://github.com/iBUHub/AIStudioToAPI drives a logged-in Google AI Studio
# session in a browser and exposes Gemini-compatible endpoints, so it needs no
# paid API key. Point the base URL at its /v1beta path and use one of the
# API_KEYS you configured in it. Its default port is 7860.
#
# GEMINI_API_BASE=http://localhost:7860/v1beta
# GEMINI_API_KEY=your-api-key-1
#
# Ask it which models it offers with: npm run gemini:doctor

# Option 2 — Google's own API, with a key from https://aistudio.google.com/apikey
# Leave GEMINI_API_BASE unset for this.
GEMINI_API_KEY=

# Which model to use. Defaults to gemini-3.5-flash.
#
#   gemini-3.5-flash        recommended: full Flash, available to at least 2027-05-19
#   gemini-3.5-flash-lite   cheapest, longest guarantee (2027-07-21); worth comparing
#   gemini-3.7-flash        newest, but "short-term availability" so it can retire soon
#   gemini-3-flash-preview  has a free tier on Google's API
#   gemini-3.1-pro-preview  overkill and not free; only if emphasis choices look poor
#
# Note: gemini-2.0-flash and the rest of the 2.0 line were retired on 2026-06-01
# and now return 404. A proxy backed by AI Studio may still offer older names —
# `npm run gemini:doctor` lists whatever yours actually has.
GEMINI_API_MODEL=gemini-3.5-flash
