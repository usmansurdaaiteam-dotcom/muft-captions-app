# Copy to .env and adjust. Everything here has a working default, so the app
# runs without any of it set.

# HTTP port.
PORT=3000

# Shared password for the team.
ACCESS_PASSWORD=muftcaptions2026

# Set to false to drop the password gate entirely. Only do this when the app is
# not reachable from the internet.
REQUIRE_PASSWORD=true

# Speech-to-text.
SONIOX_API_KEY=

# Strongly recommended. Without it, caption composition falls back to an
# unofficial path authenticated with Google session cookies, which expire on
# their own after a few weeks. When they do, line grouping and emphasis get
# noticeably worse and Urdu is no longer converted to Roman Urdu.
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_API_MODEL=gemini-2.0-flash
