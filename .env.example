# Copy to .env and fill in. The .env file is gitignored and loaded automatically
# at startup, so credentials never have to live in source or on the command line.
#
# After editing, confirm everything works:
#   npm run credentials:check

PORT=3000

# Shared password for the team.
ACCESS_PASSWORD=muftcaptions2026

# Set to false to drop the password gate entirely. Only do this when the app is
# not reachable from the internet.
REQUIRE_PASSWORD=true


# ─── Speech to text ───────────────────────────────────────────────────────────
# Required — nothing transcribes without it. https://console.soniox.com
SONIOX_API_KEY=


# ─── Caption composition ──────────────────────────────────────────────────────
#
# This is what groups words into lines, picks the emphasised word, and converts
# non-Latin script. Three possible paths, in order of preference.
#
# None of them is strictly required: without any, captions are still produced,
# but lines are grouped by pauses alone, the emphasis word becomes simply the
# longest word in each line, and script conversion stops.

# Option 1 — AIStudioToAPI, or any Gemini-compatible proxy. No paid key.
#
# https://github.com/iBUHub/AIStudioToAPI drives a logged-in Google AI Studio
# session in a real browser and exposes Gemini-compatible endpoints. Point the
# base URL at its /v1beta path and use one of the API_KEYS you configured in it.
# Its default port is 7860.
#
# GEMINI_API_BASE=http://localhost:7860/v1beta
# GEMINI_API_KEY=your-api-key-1
#
# Ask it which models it offers:  npm run gemini:doctor

# Option 2 — Google's own API. Leave GEMINI_API_BASE unset for this.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which model to use. Defaults to gemini-3.5-flash.
#
#   gemini-3.5-flash        recommended: full Flash, available to at least 2027-05-19
#   gemini-3.5-flash-lite   cheapest, longest guarantee (2027-07-21); worth comparing
#   gemini-3.7-flash        newest, but "short-term availability" so it can retire soon
#   gemini-3-flash-preview  has a free tier on Google's API
#   gemini-3.1-pro-preview  overkill and not free; only if emphasis choices look poor
#
# Note: gemini-2.0-flash and the rest of the 2.0 line were retired on 2026-06-01
# and now return 404. A proxy backed by AI Studio may still offer older names —
# `npm run gemini:doctor` lists whatever yours actually has.
GEMINI_API_MODEL=gemini-3.5-flash

# Option 3 — a gemini.google.com browser session. Free, no setup, but it is not a
# supported interface and the session expires on its own after a few weeks.
#
# Paste the whole Cookie request header from a signed-in gemini.google.com tab
# (DevTools > Network > any request > Request Headers > Cookie). SAPISID is read
# out of it automatically.
#
# When captions get noticeably worse, this is the first thing to re-check:
#   npm run credentials:check
GEMINI_COOKIES=

# Only needed if the cookie string somehow has no SAPISID in it.
GEMINI_SAPISID=
